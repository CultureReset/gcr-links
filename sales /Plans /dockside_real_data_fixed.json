  "section_rich_text": {
    "section_id": "sec_dockside_about",
    "body_text": "Climb aboard with a small group and get ready to fly! You will be safely harnessed in before the boat gently picks up speed, lifting you smoothly into the sky. Soar up to 400 feet above the Gulf of Mexico and take in breathtaking views of sugar-white beaches, crystal-clear turquoise water, marine life, and miles of coastline in every direction. Each flight lasts 8\u201310 minutes and is available for single, double, or triple riders. It's peaceful, thrilling, and unforgettable. Perfect for first timers and adventure lovers alike!"
  },
  "section_bullets": [
    {
      "section_id": "sec_dockside_highlights",
      "bullet_text": "\u2726 Enjoy panoramic views of the Gulf Coast on an Orange Beach: Dockside Parasail experience",
      "sort_order": 1
    },
    {
      "section_id": "sec_dockside_highlights",
      "bullet_text": "\u2726 Soar up to 400 feet above the Gulf of Mexico with an 8\u201310-minute flight time",
      "sort_order": 2
    },
    {
      "section_id": "sec_dockside_highlights",
      "bullet_text": "\u2726 Small group boat experience that is safe and perfect for first timers",
      "sort_order": 3
    },
    {
      "section_id": "sec_dockside_highlights",
      "bullet_text": "\u2726 Single, double, or triple flights available",
      "sort_order": 4
    },
    {
      "section_id": "sec_dockside_highlights",
      "bullet_text": "\u2726 Perfect for ages 5+",
      "sort_order": 5
    },
    {
      "section_id": "sec_dockside_restrictions",
      "bullet_text": "Participants must be at least 5 years old or older to ride on the boat or parasail.",
      "sort_order": 1
    },
    {
      "section_id": "sec_dockside_restrictions",
      "bullet_text": "The combined weight of guests flying must be between 150 and 450 pounds.",
      "sort_order": 2
    },
    {
      "section_id": "sec_dockside_restrictions",
      "bullet_text": "Children under 14 years old must be accompanied on the parasail boat by a guest who is 16 years old or older.",
      "sort_order": 3
    },
    {
      "section_id": "sec_dockside_restrictions",
      "bullet_text": "For guests under the age of 19, a parent or legal guardian is required to sign a waiver. Guests 19 years of age or older may sign their own waiver.",
      "sort_order": 4
    },
    {
      "section_id": "sec_dockside_restrictions",
      "bullet_text": "Electronics and shoes are not permitted on the boat. These items may be safely left with a team member at the beach.",
      "sort_order": 5
    },
    {
      "section_id": "sec_dockside_restrictions",
      "bullet_text": "Expectant mothers are not permitted.",
      "sort_order": 6
    },
    {
      "section_id": "sec_dockside_restrictions",
      "bullet_text": "There is a maximum of 2 observers.",
      "sort_order": 7
    },
    {
      "section_id": "sec_dockside_restrictions",
      "bullet_text": "This departure location allows guests to step directly onto the vessel. There is a place for guests to leave their wheelchairs/walkers/scooters at the dock during the excursion.",
      "sort_order": 8
    }
  ],
