  "section_rich_text": [
    {
      "section_id": "sec_dockside_about",
      "body_text": "Climb aboard with a small group and get ready to fly! You will be safely harnessed in before the boat gently picks up speed, lifting you smoothly into the sky. Soar up to 400 feet above the Gulf of Mexico and take in breathtaking views of sugar-white beaches, crystal-clear turquoise water, marine life, and miles of coastline in every direction. Each flight lasts 8\u201310 minutes and is available for single, double, or triple riders. It's peaceful, thrilling, and unforgettable. Perfect for first timers and adventure lovers alike!"
    }
  ],
  "section_bullets": [
    {
      "section_id": "sec_dockside_highlights",
      "bullet_text": "Enjoy panoramic views of the Gulf Coast on an Orange Beach: Dockside Parasail experience",
      "sort_order": 1
    },
    {
      "section_id": "sec_dockside_highlights",
      "bullet_text": "Soar up to 400 feet above the Gulf of Mexico",
      "sort_order": 2
    },
    {
      "section_id": "sec_dockside_highlights",
      "bullet_text": "Fly for 8\u201310 minutes with single, double, or triple rider options",
      "sort_order": 3
    },
    {
      "section_id": "sec_dockside_highlights",
      "bullet_text": "Small group experience that is safe for first timers",
      "sort_order": 4
    },
    {
      "section_id": "sec_dockside_highlights",
      "bullet_text": "Perfect beach-day adventure for ages 5+",
      "sort_order": 5
    },
    {
      "section_id": "sec_dockside_restrictions",
      "bullet_text": "Participants must be at least 5 years old or older to ride on the boat or parasail.",
      "sort_order": 1
    },
    {
      "section_id": "sec_dockside_restrictions",
      "bullet_text": "The combined weight of guests flying must be between 150 and 450 pounds.",
      "sort_order": 2
    },
    {
      "section_id": "sec_dockside_restrictions",
      "bullet_text": "Solo flyers can parasail if they meet the weight minimum and maximum requirements.",
      "sort_order": 3
    },
    {
      "section_id": "sec_dockside_restrictions",
      "bullet_text": "All participants must sign a waiver prior to departure.",
      "sort_order": 4
    },
    {
      "section_id": "sec_dockside_restrictions",
      "bullet_text": "Trip duration is approximately 1 hour total, with 8\u201310 minutes of flight time.",
      "sort_order": 5
    }
  ],
